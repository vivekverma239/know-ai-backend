{
  "files": {
    "include": ["src/**/*.ts"],
    "ignore": ["dist", "node_modules", "data", "build", "coverage", "test"]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "suspicious": {
        "noExplicitAny": "error"
      }
    }
  }
}
