{
  "name": "knowsis-backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "vitest run",
    "test:e2e": "vitest run test/e2e/",
    "test:watch": "vitest",
    "test:doc-parsing": "tsx test/docParsing.test.ts",
    "test:chat-stream": "tsx test/chatStream.test.ts",
    "test:ingestion-webhook": "tsx test/ingestionWebhook.test.ts",
    "test:admin-dashboard": "tsx test/adminDashboard.test.ts",
    "test:e2e-ingestion": "tsx test/e2e-ingestion.test.ts",
    "test:e2e-ingestion-webhook": "tsx test/e2e-ingestion-webhook.test.ts",
    "test:all": "npm run test:doc-parsing && npm run test:chat-stream",
    "dev": "dotenvx run -- nodemon --watch src --watch .env --ext ts,env --exec \"tsx src/server.ts\"",
    "start": "dotenvx run -- node dist/server.js",
    "build": "tsc && tsc-alias",
    "dev:inspect": "node --inspect --loader ts-node/esm src/server.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "admin:dev": "pnpm --dir admin-dashboard dev",
    "admin:build": "pnpm --dir admin-dashboard build",
    "admin:preview": "pnpm --dir admin-dashboard preview",
    "admin:create-users": "tsx scripts/generateAdminUsersJson.ts",
    "admin:generate-users-json": "tsx scripts/generateAdminUsersJson.ts",
    "tunnel": "cloudflared tunnel run --url http://localhost:3000 knowsis-dev",
    "sync:auth": "tsx scripts/sync_auth_tables.ts",
    "test:smoke": "tsx test/smokeTest.ts"
  },
